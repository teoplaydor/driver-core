<Project Sdk="Microsoft.NET.Sdk">
  <!-- WinForms via FrameworkReference so the exe builds with any .NET 8 SDK (also on Linux). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SemSearch</AssemblyName>
    <RootNamespace>SemSearch</RootNamespace>
    <Product>Смысловой поиск</Product>
    <AssemblyTitle>Смысловой поиск — EmbeddingGemma 2 на ПК</AssemblyTitle>
    <Version>0.1.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Trim only the framework libraries marked trimmable; WinForms, ONNX Runtime and the app stay whole. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <ProjectReference Include="..\SemSearch.Core\SemSearch.Core.csproj" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- App-local Visual C++ runtime for onnxruntime.dll (PCs without the VC++ Redistributable); build.sh fetches it. -->
    <Content Include="..\redist\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The WindowsDesktop runtime pack also carries WPF (~20 MB compressed) and the WinForms designer; the app
       references none of it, so keep it out of the exe. -->
  <PropertyGroup>
    <_DropPattern>^(Presentation.*|ReachFramework|System\.Printing|System\.Windows\.Forms\.Design.*|System\.CodeDom|Microsoft\.VisualBasic\.Forms|System\.Windows\.Controls\.Ribbon|System\.Windows\.Input\.Manipulations|System\.Windows\.Presentation|System\.Xaml|UIAutomation.*|WindowsBase|WindowsFormsIntegration|DirectWriteForwarder|D3DCompiler_47_cor3|PenImc_cor3|wpfgfx_cor3)$</_DropPattern>
  </PropertyGroup>
  <Target Name="DropUnusedRuntimePackAssets" AfterTargets="ResolveRuntimePackAssets">
    <ItemGroup>
      <RuntimePackAsset Remove="@(RuntimePackAsset)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '$(_DropPattern)'))" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '$(_DropPattern)'))" />
    </ItemGroup>
  </Target>
  <!-- Same ONNX Runtime version, but the native library built with the WebGPU execution provider (build.sh takes it
       from the onnxruntime-webgpu wheel): the NuGet one is CPU-only. Item transforms keep the package metadata. -->
  <Target Name="UseWebGpuOnnxRuntime" AfterTargets="ResolvePackageAssets">
    <Error Condition="!Exists('..\redist-ort\onnxruntime.dll')" Text="redist-ort\onnxruntime.dll is missing: run build.sh" />
    <ItemGroup>
      <_OrtNative Include="@(NativeCopyLocalItems)" Condition="'%(Filename)%(Extension)' == 'onnxruntime.dll' Or '%(Filename)%(Extension)' == 'onnxruntime_providers_shared.dll'" />
      <NativeCopyLocalItems Remove="@(_OrtNative)" />
      <NativeCopyLocalItems Include="@(_OrtNative->'$(MSBuildProjectDirectory)\..\redist-ort\%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>
  <!-- The package's .props also adds its natives as None items (for non-SDK projects); they would win in the bundle. -->
  <Target Name="DropOrtPackageNoneItems" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Remove="@(None)" Condition="'%(None.Link)' == 'onnxruntime.dll' Or '%(None.Link)' == 'onnxruntime_providers_shared.dll'" />
    </ItemGroup>
  </Target>
  <Target Name="DropUnusedPackageAssets" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '$(_DropPattern)'))" />
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '$(_DropPattern)'))" />
    </ItemGroup>
  </Target>
</Project>
