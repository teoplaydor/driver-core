<?xml version="1.0" encoding="utf-8"?>
<!-- A note by voice from the home screen (or the lock screen where the phone allows widgets there). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_quick"
    android:minWidth="180dp"
    android:minHeight="48dp"
    android:minResizeWidth="120dp"
    android:minResizeHeight="40dp"
    android:previewLayout="@layout/widget_quick"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen|keyguard" />
