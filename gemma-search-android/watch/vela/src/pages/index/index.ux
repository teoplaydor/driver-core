<template>
  <div class="page">
    <text class="title">Пульт кистью</text>
    <text class="state">{{ state }}</text>
    <text class="note" show="{{ note !== '' }}">{{ note }}</text>
    <text class="err" show="{{ err !== '' }}">{{ err }}</text>
    <text class="diag">{{ diag }}</text>
    <text class="bg" show="{{ on && bg !== '' }}">{{ bg }}</text>
    <text class="hint">{{ voiceOn ? 'Вправо — дальше, влево — назад · ко рту — заметка' : 'Вправо — дальше, влево — назад' }}</text>
    <input type="button" class="button" value="{{ on ? 'Стоп' : 'Старт' }}" onclick="toggle" />
    <input type="button" class="small" show="{{ voiceOn }}" value="Запомнить положение у рта" onclick="teach" />
    <text class="hint" show="{{ voiceOn && poses > 0 }}">{{ 'Запомнено положений: ' + poses }}</text>
    <input type="button" class="small" show="{{ voiceOn && poses > 0 }}" value="Забыть положения" onclick="forget" />
    <input type="button" class="small" show="{{ voiceOn }}" value="{{ soundsOn ? 'Звуки заметки: вкл' : 'Звуки заметки: выкл' }}" onclick="sounds" />
    <input type="button" class="small" value="{{ screenOn ? 'Экран: не гаснет' : 'Экран: гаснет' }}" onclick="screen" />
  </div>
</template>

<script>
/**
 * The screen of «Пульт кистью»: what the link to the phone (common/link.js, made by the app — app.ux) is doing, and its
 * switches. The link does not live here: leaving the page leaves it running (in the background, while it is on).
 */
export default {
  data: {
    on: false,
    state: '',
    diag: '',
    note: '',
    bg: '',
    voiceOn: true,
    screenOn: false,
    poses: 0,
    soundsOn: true,
    err: ''
  },

  onInit() {
    this.link = this.$app.$def.link
    const self = this
    this.link.watch(function (v) {
      self.on = v.on
      self.state = v.state
      self.diag = v.diag
      self.note = v.note
      self.bg = v.bg
      self.voiceOn = v.voiceOn
      self.screenOn = v.screenOn
      self.poses = v.poses
      self.soundsOn = v.soundsOn
      self.err = v.err
    })
    this.link.visible(true)
  },

  onShow() {
    this.link.visible(true)
  },

  onHide() {
    this.link.visible(false)
  },

  onDestroy() {
    this.link.visible(false)
    this.link.watch(null)
  },

  toggle() {
    this.link.toggle()
  },

  /**
   * Teach how this hand holds the watch to the mouth: tap, then hold it there as when talking, still for a second (up
   * to three ways; a voice note then starts from any of them).
   */
  teach() {
    this.link.teachTalk()
  },

  forget() {
    this.link.forgetTalk()
  },

  /** The bells before and after a note: on or off. */
  sounds() {
    this.link.setSounds(!this.link.soundsOn)
  },

  /** Keep the screen on while this page is open (if the background does not work on this watch). */
  screen() {
    this.link.setScreen(!this.link.screenOn)
  }
}
</script>

<style>
.page {
  flex-direction: column;
  align-items: center;
  width: 480px;
  padding-top: 64px;
  padding-bottom: 90px;
  background-color: #000000;
}
.title {
  font-size: 36px;
  color: #e6edf3;
  text-align: center;
}
.state {
  margin-top: 16px;
  width: 380px;
  font-size: 28px;
  color: #8da6c0;
  text-align: center;
}
.note {
  margin-top: 10px;
  width: 400px;
  font-size: 26px;
  color: #e6edf3;
  text-align: center;
}
.diag {
  margin-top: 8px;
  width: 400px;
  font-size: 22px;
  color: #6f7d8c;
  text-align: center;
}
.err {
  margin-top: 6px;
  width: 400px;
  font-size: 20px;
  color: #e57373;
  text-align: center;
}
.bg {
  margin-top: 6px;
  width: 400px;
  font-size: 20px;
  color: #7fae8c;
  text-align: center;
}
.hint {
  margin-top: 10px;
  width: 380px;
  font-size: 24px;
  color: #8b96a3;
  text-align: center;
}
.button {
  margin-top: 26px;
  width: 200px;
  height: 72px;
  border-radius: 36px;
  font-size: 30px;
  color: #0e1116;
  background-color: #8da6c0;
}
.small {
  margin-top: 12px;
  width: 340px;
  height: 56px;
  border-radius: 28px;
  font-size: 22px;
  color: #c9d4df;
  background-color: #263241;
}
</style>
